# ══════════════════════════════════════════════════════════════════
#  DARK DEED — пример переменных окружения
#  Скопируй этот файл в .env.local и заполни своими значениями.
#  Файл .env.local в .gitignore — секреты никогда не попадут в git.
# ══════════════════════════════════════════════════════════════════

# ── Telegram Bot ───────────────────────────────────────────────
# Токен бота из @BotFather (/newbot → скопируй строку типа 123456:AAH...)
# Используется ТОЛЬКО в Supabase Edge Functions (Functions → Secrets),
# на клиент не попадает.
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=your_bot_name

# ── Supabase ───────────────────────────────────────────────────
# Заведи проект на https://supabase.com/dashboard → Settings → API
# URL и publishable-key безопасно попадают в клиентский бандл (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Пароль от базы данных — нужен только для локальных миграций через supabase CLI
# НИКОГДА не коммитить и не отдавать клиенту.
SUPABASE_DB_PASSWORD=your-db-password-here

# ── Публичный URL приложения ──────────────────────────────────
# URL Vercel-деплоя (или другого хостинга). Указывается в BotFather → Menu Button.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
